// FLUX Sparta — Cloudflare Worker configuration
//
// D-10: "directory" is ./public, NOT ".". Previously the entire repo was
//       published, so wrangler.jsonc, worker.js and STRIPE_SETUP.md were
//       fetchable at the game's domain. Only runtime assets live in ./public.
//       This is a whitelist by construction: a new source file cannot leak
//       simply by being added to the repo.
//       Secrets are unaffected either way -- STRIPE_SECRET_KEY,
//       STRIPE_WEBHOOK_SECRET and ADMIN_TOKEN are dashboard secrets and have
//       never been in any committed file.
//
// D-15: "name" is flux-sparta-3, matching the live worker. It previously said
//       flux-sparta, which would have deployed to the wrong worker if anyone
//       ever ran `wrangler deploy` from a terminal.
//
// run_worker_first keeps every /api/* request on worker.js; everything else
// falls through to the static assets in ./public.
//
// FREE PLAN (owner: FLUX stays on the free Workers plan, 100,000 Worker
// requests a day). Static asset requests are free and do NOT invoke the
// Worker. Only /api/* runs worker.js:
//   - every file in ./public (the Gateway, the game, sw.js, icons, images) is
//     served by the asset layer;
//   - "not_found_handling": "404-page" answers a missing path (a bot probing
//     /wp-login.php, a browser asking for /favicon.ico) with public/404.html
//     from the asset layer too. Without it, EVERY missing path invoked the
//     Worker script and counted against the daily limit;
//   - "html_handling": "auto-trailing-slash" (the default, written out) makes
//     /play redirect to /play/ in the asset layer, never in the Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flux-sparta-3",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  // CUSTOM DOMAIN (owner): FLUX also lives at https://fluxsparta.com (same Worker, same
  // Durable Object, same data). Declared HERE, not only in the dashboard, so a deploy
  // never wipes it. "workers_dev": true keeps the old address
  // https://flux-sparta-3.jeromevt72.workers.dev working for every player and every
  // Home Screen app installed from it. www.fluxsparta.com is NOT attached to the
  // Worker: a zone Redirect Rule (dashboard) sends it to fluxsparta.com, so a pilot
  // never splits between two addresses.
  "workers_dev": true,
  "routes": [
    { "pattern": "fluxsparta.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // RC2.8: automatic payment reconciliation every 30 minutes (free on Workers).
  "triggers": { "crons": ["*/30 * * * *"] },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD_DO",
        "class_name": "LeaderboardDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LeaderboardDO"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD",
      "id": "296ea87bdb664e61a60ada3876ae6e55"
    }
  ],
  "vars": {
    "SITE_URL": "https://flux-sparta-3.jeromevt72.workers.dev",
    "STRIPE_PRICE_TOXIC": "price_1UFmSPD3WappewxnvZMd3Uti",
    "STRIPE_PRICE_COSMIC": "price_1UFmXnD3WappewxnIBJOTvtj",
    "STRIPE_PRICE_SOLAR": "price_1UG5raD3WappewxnfLlKnVUP",
    // A-4: the store is closed on the SERVER too. Set to "true" only after
    // Stripe live keys and live price IDs are in place (T-9), together with
    // STORE_OPEN in public/play/index.html.
    "STORE_OPEN": "false"
  }
}
