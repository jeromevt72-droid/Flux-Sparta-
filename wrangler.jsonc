{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flux-sparta",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD",
      "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]
}
